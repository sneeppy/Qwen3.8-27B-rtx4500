PORT=8080
CTX=32768
MODE=single
SPEC=dflash2
PREFIX_CACHE=1
MODEL_DIR=./models

# Сгенерируйте один раз: openssl rand -hex 32
# Смена ключа после создания пользователей завершит их активные сессии.
# WEBUI_SECRET_KEY=
WEBUI_PORT=3000
# 0.0.0.0 — доступ с LAN (http://192.168.1.35:3000). Только loopback: 127.0.0.1
WEBUI_BIND=0.0.0.0
WEBUI_NAME=Qwen3.8-27B
WEBUI_ENABLE_SIGNUP=True

# API_KEY=
# Один ключ для vLLM и Open WebUI. UI получает его на сервере и не отдаёт браузеру.

# EXTRA_ARGS=

# HF_TOKEN=

# --- дополнительные knobs ---

# DFLASH_TOKENS=15
# Когда ответ цитирует/копирует длинный промпт. Урезает слоты и окно контекста.

# CTX=fast | CTX=long | CTX=huge
# Вместо числа: пресеты 64k / ~128–150k / ~240k. Числовой CTX=32768 мапится в fast + MAX_LEN.

# MODE=batch
# Много независимых запросов. Не совмещать с MODE=single на одной GPU.

# VLLM_WSL2_ENABLE_PIN_MEMORY=1
# Только Docker Desktop / WSL2. На native Linux no-op.

# GPU_UTIL=0.90
# Если сервер не встаёт по памяти (display, другие процессы).

# MAX_SEQS=8
# Не поднимать, пока не понятен пул GDN-state. На CTX=huge дефолт ещё меньше.
