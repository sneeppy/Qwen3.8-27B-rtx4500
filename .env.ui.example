WEBUI_PORT=3000

ENABLE_OLLAMA_API=False
ENABLE_OPENAI_API=True
# Порт здесь тот же, что PORT в .env.qwen (env_file не интерполирует).
OPENAI_API_BASE_URLS=http://qwen:8080/v1
# Тот же секрет, что API_KEY в .env.qwen. UI не отдаёт его браузеру.
OPENAI_API_KEYS=

WEBUI_AUTH=True
# Сгенерируйте один раз: openssl rand -hex 32
# Смена ключа после создания пользователей завершит их активные сессии.
WEBUI_SECRET_KEY=
ENABLE_SIGNUP=True
WEBUI_NAME=Qwen3.8-27B

ANONYMIZED_TELEMETRY=False
DO_NOT_TRACK=True
SCARF_NO_ANALYTICS=True
